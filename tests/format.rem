# Test the FMT / SPECIAL FORMAT facility

SET $AddBlankLines 0
SET $TerminalHyperlinks 1
BANNER %

REM Wed ++7 FMT <b>Bold <i>BoldItalic</i></b> <i>Italic</i> <s>strike<b>!</b></s> <u>under<i>line</i></u>
REM Wed ++7 SPECIAL FORMATTED <span color="#0000ff">Blue</span> <span fgcolor="#0000ff">Blue</span> <span foreground="#0000ff">Blue</span>
REM Wed ++7 FMT </b>Closing tag, LOL &gt; &lt; &amp; &wtf;
REM Wed ++7 FMT <i>Unmatched</b> closing tag, LOL.
REM Wed ++7 INFO "Url: https://dianne.skoll.ca" FMT %"Got a <b>URL!</b>%" %b
